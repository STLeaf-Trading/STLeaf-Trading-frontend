rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images — only the two authorised admin accounts can upload.
    // Public read so customers can view product images in the app.
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.uid == 'OHoXagfYOTbmSl20kKHnYXb8fwJ3' ||
         request.auth.uid == 'l5FvGMHea1X3Jr3EV8vMlDBchfw1');
    }

    // Block everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
